medida factory_tablero_destinos.el_contrato_de_la_extension_cubre_destinos:
    de tablero_destinos_caso c
    donde c.requisito == "el_contrato_de_la_extension_cubre_destinos" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_tablero_destinos.py; asociar junto a corrida_completa"
    requiere tablero_destinos_caso
    ambito universal
    alcance "escenarios td1–td5 sobre la sección Destinos del tablero: cada destino con su estado, consulta sólo a pedido, botones que sólo escriben en la terminal, sin destinos o con error, y el contrato con la extensión; con la CLI de verdad, destinos simulados por scripts locales y la extensión en node, Linux"
