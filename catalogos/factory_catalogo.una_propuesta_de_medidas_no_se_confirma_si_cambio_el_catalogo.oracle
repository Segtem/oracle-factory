medida factory_catalogo.una_propuesta_de_medidas_no_se_confirma_si_cambio_el_catalogo:
    de catalogo_caso c
    donde c.requisito == "una_propuesta_de_medidas_no_se_confirma_si_cambio_el_catalogo" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_catalogo_confirmado.py; asociar junto a corrida_completa"
    requiere catalogo_caso
    ambito universal
    alcance "escenarios cc2 en proyectos temporales, Linux, con el ejemplo notas"
