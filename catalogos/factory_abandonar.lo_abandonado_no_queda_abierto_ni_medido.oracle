medida factory_abandonar.lo_abandonado_no_queda_abierto_ni_medido:
    de abandonar_caso c
    donde c.requisito == "lo_abandonado_no_queda_abierto_ni_medido" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_abandonar.py; asociar junto a corrida_completa"
    requiere abandonar_caso
    ambito universal
    alcance "escenarios ab1-ab4 en Linux, con la terminal y el menu simulados"
