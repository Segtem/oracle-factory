medida factory_docs.la_documentacion_se_comprueba_contra_la_cli:
    de docs_caso c
    donde c.requisito == "la_documentacion_se_comprueba_contra_la_cli" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_docs.py; asociar junto a corrida_completa"
    requiere docs_caso
    ambito universal
    alcance "escenario dc2 con copias con un problema puesto a proposito"
