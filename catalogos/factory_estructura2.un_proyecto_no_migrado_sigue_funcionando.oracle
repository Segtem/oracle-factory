medida factory_estructura2.un_proyecto_no_migrado_sigue_funcionando:
    de estructura2_caso c
    donde c.requisito == "un_proyecto_no_migrado_sigue_funcionando" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_estructura2.py; asociar junto a corrida_completa"
    requiere estructura2_caso
    ambito universal
    alcance "escenarios s1-s7 en Linux sobre proyectos temporales; no migra otras máquinas ni toca el historial de Git"
