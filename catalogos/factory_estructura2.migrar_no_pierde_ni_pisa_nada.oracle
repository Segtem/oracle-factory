medida factory_estructura2.migrar_no_pierde_ni_pisa_nada:
    de estructura2_caso c
    donde c.requisito == "migrar_no_pierde_ni_pisa_nada" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_estructura2.py; asociar junto a corrida_completa"
    requiere estructura2_caso
    ambito universal
    alcance "escenarios s1-s7 en Linux sobre proyectos temporales; no migra otras máquinas ni toca el historial de Git"
