medida factory_clones.un_clon_recien_hecho_puede_trabajar:
    de clones_caso c
    donde c.requisito == "un_clon_recien_hecho_puede_trabajar" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_clones.py; asociar junto a corrida_completa"
    requiere clones_caso
    ambito universal
    alcance "escenario cl1 con git real y un repositorio central"
