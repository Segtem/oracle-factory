medida factory_puerta_local.la_puerta_detecta_secretos_en_todos_los_commits_que_se_publican:
    de puerta_local_caso c
    donde c.requisito == "la_puerta_detecta_secretos_en_todos_los_commits_que_se_publican" y c.codigo == 0
    resumen contar(1)
    umbral == 14 segun contrato porque "deben pasar los 14 casos enumerados para este requisito en tools/verify_puerta_local.py; asociar junto a corrida_completa"
    requiere puerta_local_caso
    ambito universal
    alcance "escenarios pu1 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
