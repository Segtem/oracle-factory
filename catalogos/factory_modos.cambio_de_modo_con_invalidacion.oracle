medida factory_modos.cambio_de_modo_con_invalidacion:
    de modos_caso c
    donde c.requisito == "cambio_de_modo_con_invalidacion" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_modos.py; asociar junto a corrida_completa"
    requiere modos_caso
    ambito universal
    alcance "escenarios m1-m5 en Linux; el sensor verifica identidad y completitud; no autentica actores ni prueba la claridad para una persona"
