medida factory_unir.si_las_dos_ramas_decidieron_distinto_decide_una_persona:
    de unir_caso c
    donde c.requisito == "si_las_dos_ramas_decidieron_distinto_decide_una_persona" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los casos enumerados para este requisito en tools/verify_unir.py; asociar junto a corrida_completa"
    requiere unir_caso
    ambito universal
    alcance "escenario un2 con dos personas en terminal y la union pura"
