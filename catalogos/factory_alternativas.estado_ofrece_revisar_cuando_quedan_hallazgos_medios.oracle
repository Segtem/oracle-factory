medida factory_alternativas.estado_ofrece_revisar_cuando_quedan_hallazgos_medios:
    de alternativas_caso c
    donde c.requisito == "estado_ofrece_revisar_cuando_quedan_hallazgos_medios" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_estado_revisar_medios.py; asociar junto a corrida_completa"
    requiere alternativas_caso
    ambito universal
    alcance "escenarios er1 en Linux, con revisores de prueba y oracle-clue 0.1.0a2 real"
