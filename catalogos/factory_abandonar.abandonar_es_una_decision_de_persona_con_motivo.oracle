medida factory_abandonar.abandonar_es_una_decision_de_persona_con_motivo:
    de abandonar_caso c
    donde c.requisito == "abandonar_es_una_decision_de_persona_con_motivo" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_abandonar.py; asociar junto a corrida_completa"
    requiere abandonar_caso
    ambito universal
    alcance "escenarios ab1-ab4 en Linux, con la terminal y el menu simulados"
