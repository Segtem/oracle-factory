medida factory_registros_raiz.con_registros_aparte_lo_que_necesita_candidato_no_inventa_uno:
    de registros_raiz_caso c
    donde c.requisito == "con_registros_aparte_lo_que_necesita_candidato_no_inventa_uno" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_registros_raiz.py; asociar junto a corrida_completa"
    requiere registros_raiz_caso
    ambito universal
    alcance "escenario rr3 sobre el rechazo de los comandos de candidato y el estado sin candidato, en repositorios temporales con Linux"
