medida factory_cli_modulos.la_cli_se_comporta_igual_tras_partirse:
    de cli_modulos_caso c
    donde c.requisito == "la_cli_se_comporta_igual_tras_partirse" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tools/verify_cli_modulos.py; asociar junto a corrida_completa"
    requiere cli_modulos_caso
    ambito universal
    alcance "escenarios cm1 sobre el código partido y sobre árboles temporales, Linux"
