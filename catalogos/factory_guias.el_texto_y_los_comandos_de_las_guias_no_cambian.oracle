medida factory_guias.el_texto_y_los_comandos_de_las_guias_no_cambian:
    de guias_caso c
    donde c.requisito == "el_texto_y_los_comandos_de_las_guias_no_cambian" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_web_guias.py; asociar junto a corrida_completa"
    requiere guias_caso
    ambito universal
    alcance "escenarios wg2 en Chromium headless de Linux con Playwright, sin red"
