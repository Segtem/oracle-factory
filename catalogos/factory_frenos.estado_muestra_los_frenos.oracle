medida factory_frenos.estado_muestra_los_frenos:
    de frenos_caso c
    donde c.requisito == "estado_muestra_los_frenos" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tests/test_frenos.py; asociar junto a corrida_completa"
    requiere frenos_caso
    ambito universal
    alcance "Frenos de construcción de estado: lista, avisos FRENO y JSON. Sin pruebas existentes editadas."
