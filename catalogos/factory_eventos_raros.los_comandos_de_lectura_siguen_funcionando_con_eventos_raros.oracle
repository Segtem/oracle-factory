medida factory_eventos_raros.los_comandos_de_lectura_siguen_funcionando_con_eventos_raros:
    de eventos_raros_caso c
    donde c.requisito == "los_comandos_de_lectura_siguen_funcionando_con_eventos_raros" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_eventos_raros.py; asociar junto a corrida_completa"
    requiere eventos_raros_caso
    ambito universal
    alcance "El registro tolera eventos que no son objetos: cli.leer los ignora con un aviso. Ninguna prueba existente editada."
