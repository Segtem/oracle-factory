medida factory_simultanea.pedidos_de_revision_simultaneos_sobre_el_mismo_candidato:
    de simultanea_caso c
    donde c.requisito == "pedidos_de_revision_simultaneos_sobre_el_mismo_candidato" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_revision_simultanea.py; asociar junto a corrida_completa"
    requiere simultanea_caso
    ambito universal
    alcance "escenarios rs1-rs2 en Linux, con revisores de prueba y oracle-clue 0.1.0a2 real"
