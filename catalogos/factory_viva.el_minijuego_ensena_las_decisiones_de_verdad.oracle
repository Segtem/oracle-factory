medida factory_viva.el_minijuego_ensena_las_decisiones_de_verdad:
    de viva_caso c
    donde c.requisito == "el_minijuego_ensena_las_decisiones_de_verdad" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_web_viva.py; asociar junto a corrida_completa"
    requiere viva_caso
    ambito universal
    alcance "escenarios wv2 en Chromium headless de Linux con Playwright, sin red"
