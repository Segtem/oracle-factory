medida factory_procedencia.un_lock_desactualizado_se_declara_no_confiable:
    de procedencia_caso c
    donde c.requisito == "un_lock_desactualizado_se_declara_no_confiable" y c.codigo == 0
    resumen contar(1)
    umbral == 11 segun contrato porque "deben pasar los 11 casos enumerados para este requisito en tools/verify_procedencia.py; asociar junto a corrida_completa"
    requiere procedencia_caso
    ambito universal
    alcance "escenarios pr2 en proyectos temporales con git y un entorno simulado, Linux, sin red"
