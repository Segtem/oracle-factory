medida factory_hora.la_hora_de_un_evento_distingue_lo_escrito_en_el_mismo_segundo:
    de hora_caso c
    donde c.requisito == "la_hora_de_un_evento_distingue_lo_escrito_en_el_mismo_segundo" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_hora.py; asociar junto a corrida_completa"
    requiere hora_caso
    ambito universal
    alcance "escenario ho1 en un proyecto temporal"
