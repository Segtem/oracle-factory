medida factory_pruebas_practica.una_excepcion_declarada_en_la_spec_explica_por_que_no_hay_pruebas:
    de pruebas_practica_caso c
    donde c.requisito == "una_excepcion_declarada_en_la_spec_explica_por_que_no_hay_pruebas" y c.codigo == 0
    resumen contar(1)
    umbral == 10 segun contrato porque "deben pasar los 10 casos enumerados para este requisito en tools/verify_pruebas_practica.py; asociar junto a corrida_completa"
    requiere pruebas_practica_caso
    ambito universal
    alcance "escenarios pp3 sobre proyectos temporales con la trazabilidad escrita a mano, Linux"
