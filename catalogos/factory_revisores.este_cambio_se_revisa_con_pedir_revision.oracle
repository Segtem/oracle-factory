medida factory_revisores.este_cambio_se_revisa_con_pedir_revision:
    de revisores_caso c
    donde c.requisito == "este_cambio_se_revisa_con_pedir_revision" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_revisores.py; asociar junto a corrida_completa"
    requiere revisores_caso
    ambito universal
    alcance "comprobación del verificador sobre la carpeta del candidato de este cambio"
