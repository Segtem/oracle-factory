medida factory_cli_modulos.ningun_archivo_fuente_pasa_del_tope:
    de cli_modulos_caso c
    donde c.requisito == "ningun_archivo_fuente_pasa_del_tope" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_cli_modulos.py; asociar junto a corrida_completa"
    requiere cli_modulos_caso
    ambito universal
    alcance "escenarios cm3 sobre el código partido y sobre árboles temporales, Linux"
