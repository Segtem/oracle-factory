medida factory_entorno_agente.el_agente_lanzado_recibe_un_entorno_minimo:
    de entorno_agente_caso c
    donde c.requisito == "el_agente_lanzado_recibe_un_entorno_minimo" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_entorno_agente.py; asociar junto a corrida_completa"
    requiere entorno_agente_caso
    ambito universal
    alcance "escenarios ea1–ea3 sobre el entorno del agente lanzado, con procesos y documentos de verdad, Linux"
