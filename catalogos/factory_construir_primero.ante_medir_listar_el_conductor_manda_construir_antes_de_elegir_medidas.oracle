medida factory_construir_primero.ante_medir_listar_el_conductor_manda_construir_antes_de_elegir_medidas:
    de construir_primero_caso c
    donde c.requisito == "ante_medir_listar_el_conductor_manda_construir_antes_de_elegir_medidas" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_construir_primero.py; asociar junto a corrida_completa"
    requiere construir_primero_caso
    ambito universal
    alcance "escenario cp1 sobre la decisión del conductor ante medir --listar"
