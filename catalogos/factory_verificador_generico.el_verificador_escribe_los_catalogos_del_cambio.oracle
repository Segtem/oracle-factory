medida factory_verificador_generico.el_verificador_escribe_los_catalogos_del_cambio:
    de verificador_generico_caso c
    donde c.requisito == "el_verificador_escribe_los_catalogos_del_cambio" y c.codigo == 0
    resumen contar(1)
    umbral == 8 segun contrato porque "deben pasar los 8 casos enumerados para este requisito en tests/test_verificador_generico.py; asociar junto a corrida_completa"
    requiere verificador_generico_caso
    ambito universal
    alcance "escenarios vg1–vg3 con proyectos temporales de verdad (Git, spec, registro y módulo de pruebas) y la herramienta corrida como proceso, Linux"
