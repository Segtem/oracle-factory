medida factory_higiene.un_pedido_de_revision_cortado_queda_a_la_vista:
    de higiene_caso c
    donde c.requisito == "un_pedido_de_revision_cortado_queda_a_la_vista" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_higiene.py; asociar junto a corrida_completa"
    requiere higiene_caso
    ambito universal
    alcance "escenarios hg1 en repositorios temporales, Linux, con Oracle 0.39.0 real"
