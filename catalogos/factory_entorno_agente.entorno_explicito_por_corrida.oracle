medida factory_entorno_agente.entorno_explicito_por_corrida:
    de entorno_agente_caso c
    donde c.requisito == "entorno_explicito_por_corrida" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tests/test_entorno_agente.py; asociar junto a corrida_completa"
    requiere entorno_agente_caso
    ambito universal
    alcance "escenarios ea1–ea3 sobre el entorno del agente lanzado, con procesos y documentos de verdad, Linux"
