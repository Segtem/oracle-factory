medida factory_terminal_lista.los_comandos_seguidos_se_escriben_en_orden_y_una_vez:
    de terminal_lista_caso c
    donde c.requisito == "los_comandos_seguidos_se_escriben_en_orden_y_una_vez" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_terminal_lista.py; asociar junto a corrida_completa"
    requiere terminal_lista_caso
    ambito universal
    alcance "escenarios tl3 en node con un vscode falso, Linux"
