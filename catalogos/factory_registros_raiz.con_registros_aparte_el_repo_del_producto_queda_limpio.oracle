medida factory_registros_raiz.con_registros_aparte_el_repo_del_producto_queda_limpio:
    de registros_raiz_caso c
    donde c.requisito == "con_registros_aparte_el_repo_del_producto_queda_limpio" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_registros_raiz.py; asociar junto a corrida_completa"
    requiere registros_raiz_caso
    ambito universal
    alcance "escenario rr2 sobre los registros bajo el almacén y el producto intacto, en repositorios temporales con Linux"
