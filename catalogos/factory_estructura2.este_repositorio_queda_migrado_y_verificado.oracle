medida factory_estructura2.este_repositorio_queda_migrado_y_verificado:
    de estructura2_caso c
    donde c.requisito == "este_repositorio_queda_migrado_y_verificado" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_estructura2.py; asociar junto a corrida_completa"
    requiere estructura2_caso
    ambito universal
    alcance "comprobación del verificador sobre este repositorio: sin estado en el lugar anterior, tareas/ sin cambios y estado igual antes y después; no mide otros proyectos"
