medida factory_autoproduccion.este_repositorio_produce_en_la_carpeta_del_candidato:
    de autoproduccion_caso c
    donde c.requisito == "este_repositorio_produce_en_la_carpeta_del_candidato" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_autoproduccion.py; asociar junto a corrida_completa"
    requiere autoproduccion_caso
    ambito universal
    alcance "comprobación del verificador sobre la carpeta del candidato de este cambio"
