medida factory_no_valido.donde_y_resumen_se_leen_como_json:
    de no_valido_caso c
    donde c.requisito == "donde_y_resumen_se_leen_como_json" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_donde_no_valido.py; asociar junto a corrida_completa"
    requiere no_valido_caso
    ambito universal
    alcance "escenarios cj2 en Linux, con Clue simulado"
