medida factory_resumen.el_resumen_muestra_lo_vigente_y_lo_pendiente:
    de resumen_caso c
    donde c.requisito == "el_resumen_muestra_lo_vigente_y_lo_pendiente" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_resumen.py; asociar junto a corrida_completa"
    requiere resumen_caso
    ambito universal
    alcance "escenarios r1-r6 en Linux sobre proyectos temporales; no mide que el resumen sea útil para quien lo lee"
