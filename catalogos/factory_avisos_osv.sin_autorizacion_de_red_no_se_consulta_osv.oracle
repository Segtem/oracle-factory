medida factory_avisos_osv.sin_autorizacion_de_red_no_se_consulta_osv:
    de avisos_osv_caso c
    donde c.requisito == "sin_autorizacion_de_red_no_se_consulta_osv" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_avisos_osv.py; asociar junto a corrida_completa"
    requiere avisos_osv_caso
    ambito universal
    alcance "escenarios ao1 contra un servidor OSV local de mentira, Linux, sin red"
