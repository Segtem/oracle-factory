medida factory_viva.la_portada_es_una_fabrica_viva:
    de viva_caso c
    donde c.requisito == "la_portada_es_una_fabrica_viva" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_web_viva.py; asociar junto a corrida_completa"
    requiere viva_caso
    ambito universal
    alcance "escenarios wv1 en Chromium headless de Linux con Playwright, sin red"
