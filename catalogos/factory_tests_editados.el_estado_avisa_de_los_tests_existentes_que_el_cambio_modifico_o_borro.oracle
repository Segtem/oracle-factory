medida factory_tests_editados.el_estado_avisa_de_los_tests_existentes_que_el_cambio_modifico_o_borro:
    de tests_editados_caso c
    donde c.requisito == "el_estado_avisa_de_los_tests_existentes_que_el_cambio_modifico_o_borro" y c.codigo == 0
    resumen contar(1)
    umbral == 20 segun contrato porque "deben pasar los 20 casos enumerados para este requisito en tools/verify_tests_editados.py; asociar junto a corrida_completa"
    requiere tests_editados_caso
    ambito universal
    alcance "escenarios te1 sobre repositorios Git temporales y un ejecutor de Git falso, Linux"
