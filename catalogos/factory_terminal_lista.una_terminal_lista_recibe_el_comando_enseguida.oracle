medida factory_terminal_lista.una_terminal_lista_recibe_el_comando_enseguida:
    de terminal_lista_caso c
    donde c.requisito == "una_terminal_lista_recibe_el_comando_enseguida" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_terminal_lista.py; asociar junto a corrida_completa"
    requiere terminal_lista_caso
    ambito universal
    alcance "escenarios tl2 en node con un vscode falso, Linux"
