medida factory_camino_ligero.el_camino_ligero_no_cambia_ninguna_decision_ni_paso_pendiente:
    de camino_ligero_caso c
    donde c.requisito == "el_camino_ligero_no_cambia_ninguna_decision_ni_paso_pendiente" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_camino_ligero.py; asociar junto a corrida_completa"
    requiere camino_ligero_caso
    ambito universal
    alcance "escenarios cl1–cl3 con repositorios Git temporales y la CLI de verdad, Linux"
