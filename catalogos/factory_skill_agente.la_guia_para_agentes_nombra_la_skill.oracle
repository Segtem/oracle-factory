medida factory_skill_agente.la_guia_para_agentes_nombra_la_skill:
    de skill_agente_caso c
    donde c.requisito == "la_guia_para_agentes_nombra_la_skill" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_skill_agente.py; asociar junto a corrida_completa"
    requiere skill_agente_caso
    ambito universal
    alcance "escenarios sk1–sk3 con proyectos temporales y la CLI de verdad, Linux"
