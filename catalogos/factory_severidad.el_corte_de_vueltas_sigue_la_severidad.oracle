medida factory_severidad.el_corte_de_vueltas_sigue_la_severidad:
    de severidad_caso c
    donde c.requisito == "el_corte_de_vueltas_sigue_la_severidad" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_severidad_ausente.py; asociar junto a corrida_completa"
    requiere severidad_caso
    ambito universal
    alcance "escenarios vs1 y sa1 en Linux, con revisores de prueba y oracle-clue 0.1.0a2 real"
