medida factory_entrega_a17.la_version_a17_es_coherente_y_declara_su_estado:
    de entrega_a17_caso c
    donde c.requisito == "la_version_a17_es_coherente_y_declara_su_estado" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_entrega_a17.py; asociar junto a corrida_completa"
    requiere entrega_a17_caso
    ambito universal
    alcance "escenarios ea1–ea3 con el repositorio, el wheel construido e instalado con uv en un entorno nuevo y datos armados para el juicio, Linux"
