medida factory_revision_binarios.los_binarios_nombrados_no_bloquean:
    de revision_binarios_caso c
    donde c.requisito == "los_binarios_nombrados_no_bloquean" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tests/test_revision_binarios.py; asociar junto a corrida_completa"
    requiere revision_binarios_caso
    ambito universal
    alcance "preparar la revisión: binarios omitidos del paquete"
