medida factory_revisores.el_pedido_se_genera_desde_el_cambio:
    de revisores_caso c
    donde c.requisito == "el_pedido_se_genera_desde_el_cambio" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_revisores.py; asociar junto a corrida_completa"
    requiere revisores_caso
    ambito universal
    alcance "escenarios v1-v6 en Linux con un revisor de prueba y oracle-clue real"
