medida factory_revisores.lo_que_sale_mal_no_se_guarda_como_informe:
    de revisores_caso c
    donde c.requisito == "lo_que_sale_mal_no_se_guarda_como_informe" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_revisores.py; asociar junto a corrida_completa"
    requiere revisores_caso
    ambito universal
    alcance "escenarios v1-v6 en Linux con un revisor de prueba y oracle-clue real"
