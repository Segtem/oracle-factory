medida factory_rag.los_embeddings_son_configurables_y_locales_por_defecto:
    de rag_caso c
    donde c.requisito == "los_embeddings_son_configurables_y_locales_por_defecto" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_rag.py; asociar junto a corrida_completa"
    requiere rag_caso
    ambito universal
    alcance "escenario rag3: por defecto, externa sin configurar y OpenAI de prueba"
