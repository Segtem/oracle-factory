medida factory_avisos.una_spec_de_otra_capacidad_no_se_pierde_en_silencio:
    de avisos_caso c
    donde c.requisito == "una_spec_de_otra_capacidad_no_se_pierde_en_silencio" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_avisos.py; asociar junto a corrida_completa"
    requiere avisos_caso
    ambito universal
    alcance "escenario av1 en repositorios temporales con Oracle 0.39.0"
