medida factory_clones.dos_clones_no_generan_el_mismo_id:
    de clones_caso c
    donde c.requisito == "dos_clones_no_generan_el_mismo_id" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_clones.py; asociar junto a corrida_completa"
    requiere clones_caso
    ambito universal
    alcance "escenario cl2 con dos clones y procesos simultaneos"
