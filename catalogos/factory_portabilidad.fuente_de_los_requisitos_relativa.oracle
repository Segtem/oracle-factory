medida factory_portabilidad.fuente_de_los_requisitos_relativa:
    de portabilidad_caso c
    donde c.requisito == "fuente_de_los_requisitos_relativa" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tools/verify_portabilidad.py; asociar junto a corrida_completa"
    requiere portabilidad_caso
    ambito universal
    alcance "escenarios p1-p7 en Linux; el sensor verifica identidad y completitud; la otra máquina es un clon en otra ruta, no una máquina real"
