medida factory_almacen_sincronizar.sincronizar_sube_solo_si_es_una_persona_y_no_deja_nada_a_medias:
    de almacen_sincronizar_caso c
    donde c.requisito == "sincronizar_sube_solo_si_es_una_persona_y_no_deja_nada_a_medias" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tests/test_almacen_sincronizar.py; asociar junto a corrida_completa"
    requiere almacen_sincronizar_caso
    ambito universal
    alcance "escenarios as1–as3 con repos Git temporales y un remoto bare local (sin red), Linux"
