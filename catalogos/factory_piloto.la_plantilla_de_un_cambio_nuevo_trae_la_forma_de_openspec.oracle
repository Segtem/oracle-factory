medida factory_piloto.la_plantilla_de_un_cambio_nuevo_trae_la_forma_de_openspec:
    de piloto_caso c
    donde c.requisito == "la_plantilla_de_un_cambio_nuevo_trae_la_forma_de_openspec" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_cli_piloto.py; asociar junto a corrida_completa"
    requiere piloto_caso
    ambito universal
    alcance "escenarios cp1-cp3 en proyectos temporales, Linux, con el ejemplo notas"
