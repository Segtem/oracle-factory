medida factory_bloqueo.dos_procesos_que_escriben_el_mismo_registro_no_se_pisan:
    de bloqueo_caso c
    donde c.requisito == "dos_procesos_que_escriben_el_mismo_registro_no_se_pisan" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_bloqueo_registro.py; asociar junto a corrida_completa"
    requiere bloqueo_caso
    ambito universal
    alcance "escenarios bl1 a bl3 en repositorios temporales, Linux, con un segundo proceso real"
