medida factory_preguntar.la_elaboracion_usa_herramientas_acotadas_y_un_modelo_explicito:
    de preguntar_caso c
    donde c.requisito == "la_elaboracion_usa_herramientas_acotadas_y_un_modelo_explicito" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el contrato exacto enumerado en tools/verify_preguntar.py; asociar junto a corrida_completa y las medidas de calidad del grupo"
    requiere preguntar_caso
    ambito universal
    alcance "Preguntar.test_pq2_herramientas_configuracion_fallos_y_limites; fixtures y modelos simulados, no certifica por sí sola calidad generativa real"
