medida factory_kb.por_que_existe_una_linea:
    de kb_caso c
    donde c.requisito == "por_que_existe_una_linea" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_kb.py; asociar junto a corrida_completa"
    requiere kb_caso
    ambito universal
    alcance "escenarios kb3 con git real y la extension en node con un vscode falso"
