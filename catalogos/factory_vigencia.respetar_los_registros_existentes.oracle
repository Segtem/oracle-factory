medida factory_vigencia.respetar_los_registros_existentes:
    de vigencia_caso c
    donde c.requisito == "respetar_los_registros_existentes" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tools/verify_vigencia.py; asociar junto a corrida_completa"
    requiere vigencia_caso
    ambito universal
    alcance "escenarios v1-v4 en Linux; el sensor verifica identidad y completitud; no prueba que lo revisado fuera correcto, sólo que el producto no cambió"
