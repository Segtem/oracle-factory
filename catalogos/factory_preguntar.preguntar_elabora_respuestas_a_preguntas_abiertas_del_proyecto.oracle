medida factory_preguntar.preguntar_elabora_respuestas_a_preguntas_abiertas_del_proyecto:
    de preguntar_caso c
    donde c.requisito == "preguntar_elabora_respuestas_a_preguntas_abiertas_del_proyecto" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el contrato exacto enumerado en tools/verify_preguntar.py; asociar junto a corrida_completa y las medidas de calidad del grupo"
    requiere preguntar_caso
    ambito universal
    alcance "Preguntar.test_pq1_respuesta_abierta_con_fuentes_y_herramientas; fixtures y modelos simulados, no certifica por sí sola calidad generativa real"
