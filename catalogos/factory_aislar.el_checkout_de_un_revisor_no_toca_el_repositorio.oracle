medida factory_aislar.el_checkout_de_un_revisor_no_toca_el_repositorio:
    de aislar_caso c
    donde c.requisito == "el_checkout_de_un_revisor_no_toca_el_repositorio" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_aislar.py; asociar junto a corrida_completa"
    requiere aislar_caso
    ambito universal
    alcance "escenario ai1 con Clue real y un revisor de prueba que juega con git en su checkout"
