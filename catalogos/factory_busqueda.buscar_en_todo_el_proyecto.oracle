medida factory_busqueda.buscar_en_todo_el_proyecto:
    de busqueda_caso c
    donde c.requisito == "buscar_en_todo_el_proyecto" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_evidencia_fuera.py; asociar junto a corrida_completa"
    requiere busqueda_caso
    ambito universal
    alcance "escenarios e8 y ef1 en proyectos temporales, Linux"
