medida factory_bloqueo_causa.el_bloqueo_de_aprobar_spec_dice_si_falta_un_archivo:
    de bloqueo_causa_caso c
    donde c.requisito == "el_bloqueo_de_aprobar_spec_dice_si_falta_un_archivo" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_bloqueo_causa.py; asociar junto a corrida_completa"
    requiere bloqueo_causa_caso
    ambito universal
    alcance "escenarios bc2 en proyectos temporales con git, Linux"
