medida factory_entrega_a16.la_entrega_a16_registra_sus_pruebas_y_sus_limites:
    de entrega_a16_caso c
    donde c.requisito == "la_entrega_a16_registra_sus_pruebas_y_sus_limites" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_entrega_a16.py; asociar junto a corrida_completa"
    requiere entrega_a16_caso
    ambito universal
    alcance "arneses de instalación y guía, hashes y estabilidad de fuentes; integridad local, no una publicación"
