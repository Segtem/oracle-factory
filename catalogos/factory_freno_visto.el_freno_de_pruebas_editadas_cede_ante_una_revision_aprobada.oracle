medida factory_freno_visto.el_freno_de_pruebas_editadas_cede_ante_una_revision_aprobada:
    de freno_visto_caso c
    donde c.requisito == "el_freno_de_pruebas_editadas_cede_ante_una_revision_aprobada" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tests/test_freno_visto.py; asociar junto a corrida_completa"
    requiere freno_visto_caso
    ambito universal
    alcance "escenario fv1 sobre frenos.calcular y el estado de un repositorio Git temporal, Linux"
