medida factory_sesion.la_sesion_de_live_share_se_maneja_desde_el_tablero:
    de sesion_caso c
    donde c.requisito == "la_sesion_de_live_share_se_maneja_desde_el_tablero" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_sesion.py; asociar junto a corrida_completa"
    requiere sesion_caso
    ambito universal
    alcance "escenarios se1 con un Live Share falso en node; los comandos reales de Live Share los verifica una persona"
