medida factory_modos.modo_explicito_por_cambio:
    de modos_caso c
    donde c.requisito == "modo_explicito_por_cambio" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_modos.py; asociar junto a corrida_completa"
    requiere modos_caso
    ambito universal
    alcance "escenarios m1-m5 en Linux; el sensor verifica identidad y completitud; no autentica actores ni prueba la claridad para una persona"
