medida factory_bloqueos.el_proximo_paso_sin_revisor_lo_explica:
    de bloqueos_caso c
    donde c.requisito == "el_proximo_paso_sin_revisor_lo_explica" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_bloqueos.py; asociar junto a corrida_completa"
    requiere bloqueos_caso
    ambito universal
    alcance "escenarios bl1 a bl4 en repositorios temporales, Linux, con Oracle 0.38.2 real"
