medida factory_quien.estado_y_el_tablero_muestran_quien_trabaja_en_que:
    de quien_caso c
    donde c.requisito == "estado_y_el_tablero_muestran_quien_trabaja_en_que" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_quien.py; asociar junto a corrida_completa"
    requiere quien_caso
    ambito universal
    alcance "escenarios qn2 en repositorios temporales, Linux, con Oracle 0.39.0; el panel en node con un vscode falso"
