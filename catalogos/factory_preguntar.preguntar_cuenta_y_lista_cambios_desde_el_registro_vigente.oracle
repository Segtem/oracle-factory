medida factory_preguntar.preguntar_cuenta_y_lista_cambios_desde_el_registro_vigente:
    de preguntar_caso c
    donde c.requisito == "preguntar_cuenta_y_lista_cambios_desde_el_registro_vigente" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el contrato exacto enumerado en tools/verify_preguntar.py; asociar junto a corrida_completa y las medidas de calidad del grupo"
    requiere preguntar_caso
    ambito universal
    alcance "Preguntar.test_pq3_cuenta_lista_cero_y_actualiza_registro; fixtures y modelos simulados, no certifica por sí sola calidad generativa real"
