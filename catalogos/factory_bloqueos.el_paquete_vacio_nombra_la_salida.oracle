medida factory_bloqueos.el_paquete_vacio_nombra_la_salida:
    de bloqueos_caso c
    donde c.requisito == "el_paquete_vacio_nombra_la_salida" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tools/verify_bloqueos.py; asociar junto a corrida_completa"
    requiere bloqueos_caso
    ambito universal
    alcance "escenarios bl1 a bl4 en repositorios temporales, Linux, con Oracle 0.38.2 real"
