medida factory_archivo.se_distingue_lo_vigente_de_lo_reemplazado:
    de archivo_caso c
    donde c.requisito == "se_distingue_lo_vigente_de_lo_reemplazado" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_archivo.py; asociar junto a corrida_completa"
    requiere archivo_caso
    ambito universal
    alcance "escenarios a1-a6 en Linux sobre proyectos temporales; no mide que la spec consolidada sea legible"
