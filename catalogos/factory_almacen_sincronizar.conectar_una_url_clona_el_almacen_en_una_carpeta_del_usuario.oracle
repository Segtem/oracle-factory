medida factory_almacen_sincronizar.conectar_una_url_clona_el_almacen_en_una_carpeta_del_usuario:
    de almacen_sincronizar_caso c
    donde c.requisito == "conectar_una_url_clona_el_almacen_en_una_carpeta_del_usuario" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tests/test_almacen_sincronizar.py; asociar junto a corrida_completa"
    requiere almacen_sincronizar_caso
    ambito universal
    alcance "escenarios as1–as3 con repos Git temporales y un remoto bare local (sin red), Linux"
