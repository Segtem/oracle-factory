medida factory_partir_cli.cli_py_queda_con_margen_bajo_su_tope:
    de partir_cli_caso c
    donde c.requisito == "cli_py_queda_con_margen_bajo_su_tope" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_partir_cli.py; asociar junto a corrida_completa"
    requiere partir_cli_caso
    ambito universal
    alcance "escenarios pc1–pc2 sobre el tamaño de cli.py y la mudanza a proyecto.py, Linux"
