medida factory_avisos_osv.un_fallo_de_consulta_no_se_lee_como_sin_afectados:
    de avisos_osv_caso c
    donde c.requisito == "un_fallo_de_consulta_no_se_lee_como_sin_afectados" y c.codigo == 0
    resumen contar(1)
    umbral == 22 segun contrato porque "deben pasar los 22 casos enumerados para este requisito en tools/verify_avisos_osv.py; asociar junto a corrida_completa"
    requiere avisos_osv_caso
    ambito universal
    alcance "escenarios ao3 contra un servidor OSV local de mentira, Linux, sin red"
