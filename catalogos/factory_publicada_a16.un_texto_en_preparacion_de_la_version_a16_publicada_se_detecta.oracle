medida factory_publicada_a16.un_texto_en_preparacion_de_la_version_a16_publicada_se_detecta:
    de publicada_a16_caso c
    donde c.requisito == "un_texto_en_preparacion_de_la_version_a16_publicada_se_detecta" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_publicada_a16.py; asociar junto a corrida_completa"
    requiere publicada_a16_caso
    ambito universal
    alcance "escenarios pa2 sobre los textos del repositorio y copias temporales, Linux"
