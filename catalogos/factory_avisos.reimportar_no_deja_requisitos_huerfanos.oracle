medida factory_avisos.reimportar_no_deja_requisitos_huerfanos:
    de avisos_caso c
    donde c.requisito == "reimportar_no_deja_requisitos_huerfanos" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_avisos.py; asociar junto a corrida_completa"
    requiere avisos_caso
    ambito universal
    alcance "escenario av2 en repositorios temporales con Oracle 0.39.0"
