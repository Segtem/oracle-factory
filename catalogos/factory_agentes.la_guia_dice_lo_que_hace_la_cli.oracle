medida factory_agentes.la_guia_dice_lo_que_hace_la_cli:
    de agentes_caso c
    donde c.requisito == "la_guia_dice_lo_que_hace_la_cli" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_agentes.py; asociar junto a corrida_completa"
    requiere agentes_caso
    ambito universal
    alcance "escenario ag2 con las ordenes del agente en una terminal"
