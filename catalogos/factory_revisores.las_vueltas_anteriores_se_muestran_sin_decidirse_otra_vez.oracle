medida factory_revisores.las_vueltas_anteriores_se_muestran_sin_decidirse_otra_vez:
    de revisores_caso c
    donde c.requisito == "las_vueltas_anteriores_se_muestran_sin_decidirse_otra_vez" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_revisores.py; asociar junto a corrida_completa"
    requiere revisores_caso
    ambito universal
    alcance "escenarios v1-v6 en Linux con un revisor de prueba y oracle-clue real"
