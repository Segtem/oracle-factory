medida factory_bloqueo_causa.aprobar_spec_no_cambia_cuando_todo_esta_completo:
    de bloqueo_causa_caso c
    donde c.requisito == "aprobar_spec_no_cambia_cuando_todo_esta_completo" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tools/verify_bloqueo_causa.py; asociar junto a corrida_completa"
    requiere bloqueo_causa_caso
    ambito universal
    alcance "escenarios bc3 en proyectos temporales con git, Linux"
