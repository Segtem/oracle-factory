medida factory_unir.el_registro_de_un_cambio_editado_en_dos_ramas_se_une_sin_perder_nada:
    de unir_caso c
    donde c.requisito == "el_registro_de_un_cambio_editado_en_dos_ramas_se_une_sin_perder_nada" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los casos enumerados para este requisito en tools/verify_unir.py; asociar junto a corrida_completa"
    requiere unir_caso
    ambito universal
    alcance "escenario un1 con dos clones y la union pura"
