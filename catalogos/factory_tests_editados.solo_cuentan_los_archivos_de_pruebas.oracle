medida factory_tests_editados.solo_cuentan_los_archivos_de_pruebas:
    de tests_editados_caso c
    donde c.requisito == "solo_cuentan_los_archivos_de_pruebas" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_tests_editados.py; asociar junto a corrida_completa"
    requiere tests_editados_caso
    ambito universal
    alcance "escenarios te3 sobre repositorios Git temporales y un ejecutor de Git falso, Linux"
