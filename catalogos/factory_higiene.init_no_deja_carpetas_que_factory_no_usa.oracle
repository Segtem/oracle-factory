medida factory_higiene.init_no_deja_carpetas_que_factory_no_usa:
    de higiene_caso c
    donde c.requisito == "init_no_deja_carpetas_que_factory_no_usa" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_higiene.py; asociar junto a corrida_completa"
    requiere higiene_caso
    ambito universal
    alcance "escenarios hg3 en repositorios temporales, Linux, con Oracle 0.39.0 real"
