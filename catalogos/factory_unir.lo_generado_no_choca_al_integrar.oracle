medida factory_unir.lo_generado_no_choca_al_integrar:
    de unir_caso c
    donde c.requisito == "lo_generado_no_choca_al_integrar" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los casos enumerados para este requisito en tools/verify_unir.py; asociar junto a corrida_completa"
    requiere unir_caso
    ambito universal
    alcance "escenario un3 con resumen y kb generados en dos ramas"
