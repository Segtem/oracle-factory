medida factory_tablero.el_tablero_junta_todo_lo_de_cada_cambio_y_sus_metricas:
    de tablero_caso c
    donde c.requisito == "el_tablero_junta_todo_lo_de_cada_cambio_y_sus_metricas" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_tablero.py; asociar junto a corrida_completa"
    requiere tablero_caso
    ambito universal
    alcance "escenarios tb1 en repositorios temporales, Linux, con Oracle 0.39.0 real; el panel en node con un vscode falso"
