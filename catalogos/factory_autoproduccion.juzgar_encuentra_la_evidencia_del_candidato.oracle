medida factory_autoproduccion.juzgar_encuentra_la_evidencia_del_candidato:
    de autoproduccion_caso c
    donde c.requisito == "juzgar_encuentra_la_evidencia_del_candidato" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_autoproduccion.py; asociar junto a corrida_completa"
    requiere autoproduccion_caso
    ambito universal
    alcance "escenarios p1-p4 en Linux sobre proyectos temporales, con informes de revisores de prueba"
