medida factory_entrega_a14.la_version_de_entrega_es_coherente_y_declara_su_estado:
    de entrega_caso c
    donde c.requisito == "la_version_de_entrega_es_coherente_y_declara_su_estado" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_entrega_a14.py; asociar junto a corrida_completa"
    requiere entrega_caso
    ambito universal
    alcance "coherencia de versión en metadatos, CLI, notas, docs y web, distinguiendo preparación de publicación realizada"
