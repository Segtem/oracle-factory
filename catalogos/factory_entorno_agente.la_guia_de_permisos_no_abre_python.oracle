medida factory_entorno_agente.la_guia_de_permisos_no_abre_python:
    de entorno_agente_caso c
    donde c.requisito == "la_guia_de_permisos_no_abre_python" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_entorno_agente.py; asociar junto a corrida_completa"
    requiere entorno_agente_caso
    ambito universal
    alcance "escenarios ea1–ea3 sobre el entorno del agente lanzado, con procesos y documentos de verdad, Linux"
