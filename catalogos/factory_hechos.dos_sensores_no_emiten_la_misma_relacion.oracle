medida factory_hechos.dos_sensores_no_emiten_la_misma_relacion:
    de hechos_caso c
    donde c.requisito == "dos_sensores_no_emiten_la_misma_relacion" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_hechos_varios.py; asociar junto a corrida_completa"
    requiere hechos_caso
    ambito universal
    alcance "escenarios hv2 en repositorios temporales, Linux, con Oracle 0.39.0 real"
