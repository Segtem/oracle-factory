medida factory_quien.el_trailer_elige_bien_el_cambio:
    de quien_caso c
    donde c.requisito == "el_trailer_elige_bien_el_cambio" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_quien.py; asociar junto a corrida_completa"
    requiere quien_caso
    ambito universal
    alcance "escenarios qn3 en repositorios temporales, Linux, con git real y Oracle 0.39.0"
