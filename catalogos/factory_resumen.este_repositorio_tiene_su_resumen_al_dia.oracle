medida factory_resumen.este_repositorio_tiene_su_resumen_al_dia:
    de resumen_caso c
    donde c.requisito == "este_repositorio_tiene_su_resumen_al_dia" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_resumen.py; asociar junto a corrida_completa"
    requiere resumen_caso
    ambito universal
    alcance "comprobación del verificador: resumen --verificar sobre este repositorio"
