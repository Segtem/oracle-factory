medida factory_tablero_equipo.actividad_reciente_del_proyecto:
    de tablero_equipo_caso c
    donde c.requisito == "actividad_reciente_del_proyecto" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_tablero_equipo.py; asociar junto a corrida_completa"
    requiere tablero_equipo_caso
    ambito universal
    alcance "escenarios tbe2: el JSON con la CLI de verdad y la página del tablero en node, Linux"
