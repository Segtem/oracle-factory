medida factory_simultanea.un_pedido_interrumpido_no_traba_los_siguientes:
    de simultanea_caso c
    donde c.requisito == "un_pedido_interrumpido_no_traba_los_siguientes" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_revision_simultanea.py; asociar junto a corrida_completa"
    requiere simultanea_caso
    ambito universal
    alcance "escenarios rs1-rs2 en Linux, con revisores de prueba y oracle-clue 0.1.0a2 real"
