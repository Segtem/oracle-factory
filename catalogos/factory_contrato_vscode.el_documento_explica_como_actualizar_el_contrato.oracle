medida factory_contrato_vscode.el_documento_explica_como_actualizar_el_contrato:
    de contrato_vscode_caso c
    donde c.requisito == "el_documento_explica_como_actualizar_el_contrato" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_contrato_vscode.py; asociar junto a corrida_completa"
    requiere contrato_vscode_caso
    ambito universal
    alcance "escenarios cv1–cv3 con proyectos temporales de Factory, la CLI de verdad y node, Linux"
