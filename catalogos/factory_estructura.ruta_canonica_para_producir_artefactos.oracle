medida factory_estructura.ruta_canonica_para_producir_artefactos:
    de estructura_caso c
    donde c.requisito == "ruta_canonica_para_producir_artefactos" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_estructura.py; asociar junto a corrida_completa"
    requiere estructura_caso
    ambito universal
    alcance "escenarios e1-e10 en Linux; el sensor verifica identidad y completitud; no mide que la guia sea clara ni la fase 2"
