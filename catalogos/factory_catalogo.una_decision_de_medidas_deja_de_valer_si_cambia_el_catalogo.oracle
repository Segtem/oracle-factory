medida factory_catalogo.una_decision_de_medidas_deja_de_valer_si_cambia_el_catalogo:
    de catalogo_caso c
    donde c.requisito == "una_decision_de_medidas_deja_de_valer_si_cambia_el_catalogo" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_catalogo_confirmado.py; asociar junto a corrida_completa"
    requiere catalogo_caso
    ambito universal
    alcance "escenarios cc1 en proyectos temporales, Linux, con el ejemplo notas"
