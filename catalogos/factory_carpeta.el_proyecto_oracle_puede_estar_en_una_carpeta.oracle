medida factory_carpeta.el_proyecto_oracle_puede_estar_en_una_carpeta:
    de carpeta_caso c
    donde c.requisito == "el_proyecto_oracle_puede_estar_en_una_carpeta" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tools/verify_oracle_en_carpeta.py; asociar junto a corrida_completa"
    requiere carpeta_caso
    ambito universal
    alcance "escenarios oc1 en repositorios temporales, Linux, con Oracle 0.38.2 real"
