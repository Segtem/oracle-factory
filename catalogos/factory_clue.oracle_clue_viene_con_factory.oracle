medida factory_clue.oracle_clue_viene_con_factory:
    de clue_caso c
    donde c.requisito == "oracle_clue_viene_con_factory" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_clue.py; asociar junto a corrida_completa"
    requiere clue_caso
    ambito universal
    alcance "escenarios k1-k3 en Linux con el oracle-clue del entorno de Factory"
