medida factory_mcp.un_agente_consulta_el_proyecto_por_mcp_sin_poder_cambiarlo:
    de mcp_caso c
    donde c.requisito == "un_agente_consulta_el_proyecto_por_mcp_sin_poder_cambiarlo" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_mcp.py; asociar junto a corrida_completa"
    requiere mcp_caso
    ambito universal
    alcance "escenario mc1 con el servidor por stdio y la CLI de verdad"
