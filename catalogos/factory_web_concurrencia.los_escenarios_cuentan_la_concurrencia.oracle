medida factory_web_concurrencia.los_escenarios_cuentan_la_concurrencia:
    de web_concurrencia_caso c
    donde c.requisito == "los_escenarios_cuentan_la_concurrencia" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_web_concurrencia.py; asociar junto a corrida_completa"
    requiere web_concurrencia_caso
    ambito universal
    alcance "escenarios wc1–wc4 sobre el motor, la página en Chromium y las comprobaciones del sitio, Linux"
