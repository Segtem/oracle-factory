medida factory_alarmas_flujo.el_documento_nombra_los_umbrales_y_dice_que_el_conteo_de_aserciones_es_aproximado:
    de alarmas_flujo_caso c
    donde c.requisito == "el_documento_nombra_los_umbrales_y_dice_que_el_conteo_de_aserciones_es_aproximado" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_alarmas_flujo.py; asociar junto a corrida_completa"
    requiere alarmas_flujo_caso
    ambito universal
    alcance "escenarios af3 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
