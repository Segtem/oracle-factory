medida factory_commits.los_commits_de_un_cambio_se_ven_en_log_estado_y_el_tablero:
    de commits_caso c
    donde c.requisito == "los_commits_de_un_cambio_se_ven_en_log_estado_y_el_tablero" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_commits.py; asociar junto a corrida_completa"
    requiere commits_caso
    ambito universal
    alcance "escenarios cm2 en repositorios temporales, Linux, con git real y Oracle 0.39.0; el panel en node con un vscode falso"
