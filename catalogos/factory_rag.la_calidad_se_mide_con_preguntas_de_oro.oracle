medida factory_rag.la_calidad_se_mide_con_preguntas_de_oro:
    de rag_caso c
    donde c.requisito == "la_calidad_se_mide_con_preguntas_de_oro" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_rag.py; asociar junto a corrida_completa"
    requiere rag_caso
    ambito universal
    alcance "escenario rag5 con tres preguntas de oro de prueba"
