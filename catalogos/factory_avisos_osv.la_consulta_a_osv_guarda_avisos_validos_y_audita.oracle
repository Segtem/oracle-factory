medida factory_avisos_osv.la_consulta_a_osv_guarda_avisos_validos_y_audita:
    de avisos_osv_caso c
    donde c.requisito == "la_consulta_a_osv_guarda_avisos_validos_y_audita" y c.codigo == 0
    resumen contar(1)
    umbral == 11 segun contrato porque "deben pasar los 11 casos enumerados para este requisito en tools/verify_avisos_osv.py; asociar junto a corrida_completa"
    requiere avisos_osv_caso
    ambito universal
    alcance "escenarios ao2 contra un servidor OSV local de mentira, Linux, sin red"
