medida factory_quien.un_cambio_dice_quien_lo_tiene:
    de quien_caso c
    donde c.requisito == "un_cambio_dice_quien_lo_tiene" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_quien.py; asociar junto a corrida_completa"
    requiere quien_caso
    ambito universal
    alcance "escenarios qn1 en repositorios temporales, Linux, con Oracle 0.39.0"
