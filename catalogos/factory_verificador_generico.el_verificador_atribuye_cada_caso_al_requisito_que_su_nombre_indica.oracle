medida factory_verificador_generico.el_verificador_atribuye_cada_caso_al_requisito_que_su_nombre_indica:
    de verificador_generico_caso c
    donde c.requisito == "el_verificador_atribuye_cada_caso_al_requisito_que_su_nombre_indica" y c.codigo == 0
    resumen contar(1)
    umbral == 16 segun contrato porque "deben pasar los 16 casos enumerados para este requisito en tests/test_verificador_generico.py; asociar junto a corrida_completa"
    requiere verificador_generico_caso
    ambito universal
    alcance "escenarios vg1–vg3 con proyectos temporales de verdad (Git, spec, registro y módulo de pruebas) y la herramienta corrida como proceso, Linux"
