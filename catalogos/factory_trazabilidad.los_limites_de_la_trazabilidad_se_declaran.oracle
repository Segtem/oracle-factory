medida factory_trazabilidad.los_limites_de_la_trazabilidad_se_declaran:
    de trazabilidad_caso c
    donde c.requisito == "los_limites_de_la_trazabilidad_se_declaran" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_trazabilidad.py; asociar junto a corrida_completa"
    requiere trazabilidad_caso
    ambito universal
    alcance "escenarios tz1-tz3 en Linux, con casos reales trazados en repositorios temporales"
