medida factory_rag.preguntar_devuelve_pasajes_vigentes_con_su_cita:
    de rag_caso c
    donde c.requisito == "preguntar_devuelve_pasajes_vigentes_con_su_cita" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_rag.py; asociar junto a corrida_completa"
    requiere rag_caso
    ambito universal
    alcance "escenario rag1 en un proyecto temporal"
