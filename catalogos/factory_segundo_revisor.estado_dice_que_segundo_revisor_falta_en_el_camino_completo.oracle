medida factory_segundo_revisor.estado_dice_que_segundo_revisor_falta_en_el_camino_completo:
    de segundo_revisor_caso c
    donde c.requisito == "estado_dice_que_segundo_revisor_falta_en_el_camino_completo" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_segundo_revisor.py; asociar junto a corrida_completa"
    requiere segundo_revisor_caso
    ambito universal
    alcance "escenarios sr1–sr2 sobre autopilot.segundo_revisor, el conductor y el estado de un repositorio Git temporal, Linux"
