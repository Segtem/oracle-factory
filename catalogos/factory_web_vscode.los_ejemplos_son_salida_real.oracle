medida factory_web_vscode.los_ejemplos_son_salida_real:
    de web_vscode_caso c
    donde c.requisito == "los_ejemplos_son_salida_real" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tests/test_web_vscode.py; asociar junto a corrida_completa"
    requiere web_vscode_caso
    ambito universal
    alcance "escenarios wv1–wv3 sobre el repositorio y copias con imágenes, ejemplos y datos alterados, Linux"
