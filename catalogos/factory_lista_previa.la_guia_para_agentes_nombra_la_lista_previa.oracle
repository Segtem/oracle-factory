medida factory_lista_previa.la_guia_para_agentes_nombra_la_lista_previa:
    de lista_previa_caso c
    donde c.requisito == "la_guia_para_agentes_nombra_la_lista_previa" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_lista_previa.py; asociar junto a corrida_completa"
    requiere lista_previa_caso
    ambito universal
    alcance "escenarios lp3 con un revisor de prueba y la CLI de verdad, Linux"
