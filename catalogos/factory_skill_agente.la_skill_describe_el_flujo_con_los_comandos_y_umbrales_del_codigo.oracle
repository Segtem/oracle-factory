medida factory_skill_agente.la_skill_describe_el_flujo_con_los_comandos_y_umbrales_del_codigo:
    de skill_agente_caso c
    donde c.requisito == "la_skill_describe_el_flujo_con_los_comandos_y_umbrales_del_codigo" y c.codigo == 0
    resumen contar(1)
    umbral == 10 segun contrato porque "deben pasar los 10 casos enumerados para este requisito en tests/test_skill_agente.py; asociar junto a corrida_completa"
    requiere skill_agente_caso
    ambito universal
    alcance "escenarios sk1–sk3 con proyectos temporales y la CLI de verdad, Linux"
