medida factory_tablero_equipo.el_tablero_dice_a_quien_necesita:
    de tablero_equipo_caso c
    donde c.requisito == "el_tablero_dice_a_quien_necesita" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tools/verify_tablero_equipo.py; asociar junto a corrida_completa"
    requiere tablero_equipo_caso
    ambito universal
    alcance "escenarios tbe1: el JSON con la CLI de verdad y la página del tablero en node, Linux"
