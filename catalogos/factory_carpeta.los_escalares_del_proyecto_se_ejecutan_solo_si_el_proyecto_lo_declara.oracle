medida factory_carpeta.los_escalares_del_proyecto_se_ejecutan_solo_si_el_proyecto_lo_declara:
    de carpeta_caso c
    donde c.requisito == "los_escalares_del_proyecto_se_ejecutan_solo_si_el_proyecto_lo_declara" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_oracle_en_carpeta.py; asociar junto a corrida_completa"
    requiere carpeta_caso
    ambito universal
    alcance "escenarios oc3 en repositorios temporales, Linux, con Oracle 0.38.2 real"
