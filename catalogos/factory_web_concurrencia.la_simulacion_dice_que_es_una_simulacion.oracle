medida factory_web_concurrencia.la_simulacion_dice_que_es_una_simulacion:
    de web_concurrencia_caso c
    donde c.requisito == "la_simulacion_dice_que_es_una_simulacion" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_web_concurrencia.py; asociar junto a corrida_completa"
    requiere web_concurrencia_caso
    ambito universal
    alcance "escenarios wc1–wc4 sobre el motor, la página en Chromium y las comprobaciones del sitio, Linux"
