medida factory_kb.el_vault_se_genera_del_registro_y_no_se_desfasa:
    de kb_caso c
    donde c.requisito == "el_vault_se_genera_del_registro_y_no_se_desfasa" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_kb.py; asociar junto a corrida_completa"
    requiere kb_caso
    ambito universal
    alcance "escenarios kb1 en repositorios temporales con Oracle 0.39.0"
