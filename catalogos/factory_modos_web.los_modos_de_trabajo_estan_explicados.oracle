medida factory_modos_web.los_modos_de_trabajo_estan_explicados:
    de modos_web_caso c
    donde c.requisito == "los_modos_de_trabajo_estan_explicados" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_docs_web_modos.py; asociar junto a corrida_completa"
    requiere modos_web_caso
    ambito universal
    alcance "escenarios mw1 (secciones, enlaces y lectura sin JavaScript) sobre docs/modos.md, README.md y site/"
