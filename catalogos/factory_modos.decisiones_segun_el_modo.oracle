medida factory_modos.decisiones_segun_el_modo:
    de modos_caso c
    donde c.requisito == "decisiones_segun_el_modo" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_modos.py; asociar junto a corrida_completa"
    requiere modos_caso
    ambito universal
    alcance "escenarios m1-m5 en Linux; el sensor verifica identidad y completitud; no autentica actores ni prueba la claridad para una persona"
