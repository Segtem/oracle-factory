medida factory_entrega_a14.la_distribucion_instalada_ofrece_las_consultas_del_proyecto:
    de entrega_caso c
    donde c.requisito == "la_distribucion_instalada_ofrece_las_consultas_del_proyecto" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_entrega_a14.py; asociar junto a corrida_completa"
    requiere entrega_caso
    ambito universal
    alcance "wheel instalado fuera del checkout con consultas de registro, elaboración fixture y rechazo de escrituras sin tocar registro"
