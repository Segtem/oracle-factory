medida factory_registros_raiz.sin_registros_aparte_nada_cambia:
    de registros_raiz_caso c
    donde c.requisito == "sin_registros_aparte_nada_cambia" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_registros_raiz.py; asociar junto a corrida_completa"
    requiere registros_raiz_caso
    ambito universal
    alcance "escenario rr1 sobre la raíz de los registros sin --registros, en repositorios temporales con Linux"
