medida factory_idioma.la_plantilla_en_cualquier_idioma_se_aprueba_e_importa:
    de idioma_caso c
    donde c.requisito == "la_plantilla_en_cualquier_idioma_se_aprueba_e_importa" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_idioma.py; asociar junto a corrida_completa"
    requiere idioma_caso
    ambito universal
    alcance "escenarios id3 en proyectos temporales con Oracle real, Linux"
