medida factory_carpeta.init_adopta_un_proyecto_oracle_existente:
    de carpeta_caso c
    donde c.requisito == "init_adopta_un_proyecto_oracle_existente" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_oracle_en_carpeta.py; asociar junto a corrida_completa"
    requiere carpeta_caso
    ambito universal
    alcance "escenarios oc2 en repositorios temporales, Linux, con Oracle 0.38.2 real"
