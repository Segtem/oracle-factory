medida factory_guias.las_guias_tienen_su_escena_y_su_elenco:
    de guias_caso c
    donde c.requisito == "las_guias_tienen_su_escena_y_su_elenco" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_web_guias.py; asociar junto a corrida_completa"
    requiere guias_caso
    ambito universal
    alcance "escenarios wg1 en Chromium headless de Linux con Playwright, sin red"
