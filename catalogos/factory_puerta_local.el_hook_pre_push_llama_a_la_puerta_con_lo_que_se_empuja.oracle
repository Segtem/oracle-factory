medida factory_puerta_local.el_hook_pre_push_llama_a_la_puerta_con_lo_que_se_empuja:
    de puerta_local_caso c
    donde c.requisito == "el_hook_pre_push_llama_a_la_puerta_con_lo_que_se_empuja" y c.codigo == 0
    resumen contar(1)
    umbral == 26 segun contrato porque "deben pasar los 26 casos enumerados para este requisito en tools/verify_puerta_local.py; asociar junto a corrida_completa"
    requiere puerta_local_caso
    ambito universal
    alcance "escenarios pu3 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
