medida factory_entrega_a17.la_entrega_a17_registra_sus_hashes_y_sus_limites:
    de entrega_a17_caso c
    donde c.requisito == "la_entrega_a17_registra_sus_hashes_y_sus_limites" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tests/test_entrega_a17.py; asociar junto a corrida_completa"
    requiere entrega_a17_caso
    ambito universal
    alcance "escenarios ea1–ea3 con el repositorio, el wheel construido e instalado con uv en un entorno nuevo y datos armados para el juicio, Linux"
