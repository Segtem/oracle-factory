medida factory_alarmas_flujo.el_estado_avisa_cuando_el_candidato_agrega_mas_de_450_lineas_de_producto:
    de alarmas_flujo_caso c
    donde c.requisito == "el_estado_avisa_cuando_el_candidato_agrega_mas_de_450_lineas_de_producto" y c.codigo == 0
    resumen contar(1)
    umbral == 11 segun contrato porque "deben pasar los 11 casos enumerados para este requisito en tools/verify_alarmas_flujo.py; asociar junto a corrida_completa"
    requiere alarmas_flujo_caso
    ambito universal
    alcance "escenarios af2 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
