medida factory_cli_json.la_salida_de_texto_no_cambia_y_los_errores_no_se_mezclan_con_el_json:
    de cli_json_caso c
    donde c.requisito == "la_salida_de_texto_no_cambia_y_los_errores_no_se_mezclan_con_el_json" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_cli_json.py; asociar junto a corrida_completa"
    requiere cli_json_caso
    ambito universal
    alcance "escenarios cj1-cj3 en Linux, con Clue y el menu simulados"
