medida factory_kb.una_nota_humana_vence_cuando_cambian_sus_fuentes:
    de kb_caso c
    donde c.requisito == "una_nota_humana_vence_cuando_cambian_sus_fuentes" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_kb.py; asociar junto a corrida_completa"
    requiere kb_caso
    ambito universal
    alcance "escenarios kb2 en repositorios temporales con git real"
