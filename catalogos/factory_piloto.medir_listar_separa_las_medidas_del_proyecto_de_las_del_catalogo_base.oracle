medida factory_piloto.medir_listar_separa_las_medidas_del_proyecto_de_las_del_catalogo_base:
    de piloto_caso c
    donde c.requisito == "medir_listar_separa_las_medidas_del_proyecto_de_las_del_catalogo_base" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_cli_piloto.py; asociar junto a corrida_completa"
    requiere piloto_caso
    ambito universal
    alcance "escenarios cp1-cp3 en proyectos temporales, Linux, con el ejemplo notas"
