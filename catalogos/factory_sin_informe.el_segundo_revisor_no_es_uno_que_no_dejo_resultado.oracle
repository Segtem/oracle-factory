medida factory_sin_informe.el_segundo_revisor_no_es_uno_que_no_dejo_resultado:
    de sin_informe_caso c
    donde c.requisito == "el_segundo_revisor_no_es_uno_que_no_dejo_resultado" y c.codigo == 0
    resumen contar(1)
    umbral == 3 segun contrato porque "deben pasar los 3 casos enumerados para este requisito en tests/test_sin_informe.py; asociar junto a corrida_completa"
    requiere sin_informe_caso
    ambito universal
    alcance "escenario si1 sobre autopilot.segundo_revisor y el estado"
