medida factory_publicada_a17.los_textos_declaran_publicada_la_version_a17:
    de publicada_a17_caso c
    donde c.requisito == "los_textos_declaran_publicada_la_version_a17" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_publicada_a17.py; asociar junto a corrida_completa"
    requiere publicada_a17_caso
    ambito universal
    alcance "escenarios pa1–pa2 sobre el repositorio y copias con textos alterados, Linux"
