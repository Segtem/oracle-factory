medida factory_entrega_a14.la_entrega_registra_sus_pruebas_y_sus_limites:
    de entrega_caso c
    donde c.requisito == "la_entrega_registra_sus_pruebas_y_sus_limites" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_entrega_a14.py; asociar junto a corrida_completa"
    requiere entrega_caso
    ambito universal
    alcance "ejecución de verificadores, suite, hashes de fuentes y artefactos y límites declarados"
