medida factory_procedencia.se_busca_quien_uso_una_dependencia:
    de procedencia_caso c
    donde c.requisito == "se_busca_quien_uso_una_dependencia" y c.codigo == 0
    resumen contar(1)
    umbral == 11 segun contrato porque "deben pasar los 11 casos enumerados para este requisito en tools/verify_procedencia.py; asociar junto a corrida_completa"
    requiere procedencia_caso
    ambito universal
    alcance "escenarios pr4 en proyectos temporales con git y un entorno simulado, Linux, sin red"
