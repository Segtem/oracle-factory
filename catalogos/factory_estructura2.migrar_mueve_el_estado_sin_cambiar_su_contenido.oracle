medida factory_estructura2.migrar_mueve_el_estado_sin_cambiar_su_contenido:
    de estructura2_caso c
    donde c.requisito == "migrar_mueve_el_estado_sin_cambiar_su_contenido" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_estructura2.py; asociar junto a corrida_completa"
    requiere estructura2_caso
    ambito universal
    alcance "escenarios s1-s7 en Linux sobre proyectos temporales; no migra otras máquinas ni toca el historial de Git"
