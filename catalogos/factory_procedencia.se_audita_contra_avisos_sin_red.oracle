medida factory_procedencia.se_audita_contra_avisos_sin_red:
    de procedencia_caso c
    donde c.requisito == "se_audita_contra_avisos_sin_red" y c.codigo == 0
    resumen contar(1)
    umbral == 25 segun contrato porque "deben pasar los 25 casos enumerados para este requisito en tools/verify_procedencia.py; asociar junto a corrida_completa"
    requiere procedencia_caso
    ambito universal
    alcance "escenarios pr5 en proyectos temporales con git y un entorno simulado, Linux, sin red"
