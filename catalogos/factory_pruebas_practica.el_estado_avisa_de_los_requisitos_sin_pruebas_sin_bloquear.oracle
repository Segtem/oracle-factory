medida factory_pruebas_practica.el_estado_avisa_de_los_requisitos_sin_pruebas_sin_bloquear:
    de pruebas_practica_caso c
    donde c.requisito == "el_estado_avisa_de_los_requisitos_sin_pruebas_sin_bloquear" y c.codigo == 0
    resumen contar(1)
    umbral == 16 segun contrato porque "deben pasar los 16 casos enumerados para este requisito en tools/verify_pruebas_practica.py; asociar junto a corrida_completa"
    requiere pruebas_practica_caso
    ambito universal
    alcance "escenarios pp2 sobre proyectos temporales con la trazabilidad escrita a mano, Linux"
