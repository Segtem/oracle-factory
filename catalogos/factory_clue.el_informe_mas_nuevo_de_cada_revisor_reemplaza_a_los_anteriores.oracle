medida factory_clue.el_informe_mas_nuevo_de_cada_revisor_reemplaza_a_los_anteriores:
    de clue_caso c
    donde c.requisito == "el_informe_mas_nuevo_de_cada_revisor_reemplaza_a_los_anteriores" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_clue.py; asociar junto a corrida_completa"
    requiere clue_caso
    ambito universal
    alcance "escenarios k1-k5 en Linux con el oracle-clue del entorno de Factory"
