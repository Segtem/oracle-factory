medida factory_idioma.idioma_de_la_plantilla:
    de idioma_caso c
    donde c.requisito == "idioma_de_la_plantilla" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_idioma.py; asociar junto a corrida_completa"
    requiere idioma_caso
    ambito universal
    alcance "escenarios id1 en proyectos temporales, Linux"
