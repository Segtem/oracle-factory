medida factory_paquete.factory_comprueba_las_exclusiones_del_paquete:
    de paquete_caso c
    donde c.requisito == "factory_comprueba_las_exclusiones_del_paquete" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_paquete_producto.py; asociar junto a corrida_completa"
    requiere paquete_caso
    ambito universal
    alcance "escenarios pp1-pp2 en Linux, con un revisor de prueba y oracle-clue 0.1.0a2 real"
