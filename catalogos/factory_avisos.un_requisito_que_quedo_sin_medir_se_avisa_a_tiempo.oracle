medida factory_avisos.un_requisito_que_quedo_sin_medir_se_avisa_a_tiempo:
    de avisos_caso c
    donde c.requisito == "un_requisito_que_quedo_sin_medir_se_avisa_a_tiempo" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_avisos.py; asociar junto a corrida_completa"
    requiere avisos_caso
    ambito universal
    alcance "escenario av3 en repositorios temporales con Oracle 0.39.0"
