medida factory_puerta_local.la_puerta_no_modifica_el_arbol_de_trabajo:
    de puerta_local_caso c
    donde c.requisito == "la_puerta_no_modifica_el_arbol_de_trabajo" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_puerta_local.py; asociar junto a corrida_completa"
    requiere puerta_local_caso
    ambito universal
    alcance "escenarios pu4 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
