medida factory_revision_binarios.lo_no_nombrado_sigue_bloqueando:
    de revision_binarios_caso c
    donde c.requisito == "lo_no_nombrado_sigue_bloqueando" y c.codigo == 0
    resumen contar(1)
    umbral == 7 segun contrato porque "deben pasar los 7 casos enumerados para este requisito en tests/test_revision_binarios.py; asociar junto a corrida_completa"
    requiere revision_binarios_caso
    ambito universal
    alcance "preparar la revisión: binarios omitidos del paquete"
