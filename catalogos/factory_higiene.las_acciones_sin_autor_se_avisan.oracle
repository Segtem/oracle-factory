medida factory_higiene.las_acciones_sin_autor_se_avisan:
    de higiene_caso c
    donde c.requisito == "las_acciones_sin_autor_se_avisan" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_higiene.py; asociar junto a corrida_completa"
    requiere higiene_caso
    ambito universal
    alcance "escenarios hg2 en repositorios temporales, Linux, con Oracle 0.39.0 real"
