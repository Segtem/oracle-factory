medida factory_archivo.este_repositorio_queda_archivado:
    de archivo_caso c
    donde c.requisito == "este_repositorio_queda_archivado" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tools/verify_archivo.py; asociar junto a corrida_completa"
    requiere archivo_caso
    ambito universal
    alcance "cinco escenarios en proyectos temporales y la comprobación del verificador sobre este repositorio contra el commit anterior a archivar"
