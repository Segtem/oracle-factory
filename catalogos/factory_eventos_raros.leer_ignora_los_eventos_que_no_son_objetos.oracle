medida factory_eventos_raros.leer_ignora_los_eventos_que_no_son_objetos:
    de eventos_raros_caso c
    donde c.requisito == "leer_ignora_los_eventos_que_no_son_objetos" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_eventos_raros.py; asociar junto a corrida_completa"
    requiere eventos_raros_caso
    ambito universal
    alcance "El registro tolera eventos que no son objetos: cli.leer los ignora con un aviso. Ninguna prueba existente editada."
