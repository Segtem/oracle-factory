medida factory_web_paginas.toda_la_documentacion_esta_en_la_web:
    de web_paginas_caso c
    donde c.requisito == "toda_la_documentacion_esta_en_la_web" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tests/test_web_paginas.py; asociar junto a corrida_completa"
    requiere web_paginas_caso
    ambito universal
    alcance "escenarios wp1–wp4 sobre la tabla de páginas, la documentación y las seis páginas en Chromium a 360 px, Linux"
