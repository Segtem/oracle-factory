medida factory_almacen_guia.con_almacen_la_guia_y_la_skill_van_al_producto_sin_versionar:
    de almacen_guia_caso c
    donde c.requisito == "con_almacen_la_guia_y_la_skill_van_al_producto_sin_versionar" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_almacen_guia.py; asociar junto a corrida_completa"
    requiere almacen_guia_caso
    ambito universal
    alcance "escenarios ag1–ag2 con producto y almacén como repos Git temporales, Linux"
