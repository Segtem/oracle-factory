medida factory_liveshare.el_tablero_muestra_quien_esta_en_la_sesion:
    de liveshare_caso c
    donde c.requisito == "el_tablero_muestra_quien_esta_en_la_sesion" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_liveshare.py; asociar junto a corrida_completa"
    requiere liveshare_caso
    ambito universal
    alcance "escenarios ls1 con un Live Share falso en node; la sesion real la verifica una persona"
