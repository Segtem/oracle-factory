medida factory_entrega_a15.el_wheel_a15_instalado_ofrece_lo_nuevo:
    de entrega_a15_caso c
    donde c.requisito == "el_wheel_a15_instalado_ofrece_lo_nuevo" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_entrega_a15.py; asociar junto a corrida_completa"
    requiere entrega_a15_caso
    ambito universal
    alcance "wheel instalado fuera del checkout: origen y versión, las novedades de a15 en un proyecto temporal y las consultas de la entrega anterior con elaboración fixture"
