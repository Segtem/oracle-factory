medida factory_agentes.la_guia_para_agentes_se_genera_y_no_se_desactualiza:
    de agentes_caso c
    donde c.requisito == "la_guia_para_agentes_se_genera_y_no_se_desactualiza" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_agentes.py; asociar junto a corrida_completa"
    requiere agentes_caso
    ambito universal
    alcance "escenario ag1 en un proyecto temporal"
