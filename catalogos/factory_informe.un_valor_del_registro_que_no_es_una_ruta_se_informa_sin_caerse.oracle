medida factory_informe.un_valor_del_registro_que_no_es_una_ruta_se_informa_sin_caerse:
    de informe_caso c
    donde c.requisito == "un_valor_del_registro_que_no_es_una_ruta_se_informa_sin_caerse" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_informe_no_texto.py; asociar junto a corrida_completa"
    requiere informe_caso
    ambito universal
    alcance "escenarios in1 e in2 en repositorios temporales, Linux, con Oracle 0.38.2 real"
