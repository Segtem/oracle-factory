medida factory_cli_modulos.lo_movido_lee_a_cli_en_el_momento_de_usarlo:
    de cli_modulos_caso c
    donde c.requisito == "lo_movido_lee_a_cli_en_el_momento_de_usarlo" y c.codigo == 0
    resumen contar(1)
    umbral == 7 segun contrato porque "deben pasar los 7 casos enumerados para este requisito en tools/verify_cli_modulos.py; asociar junto a corrida_completa"
    requiere cli_modulos_caso
    ambito universal
    alcance "escenarios cm2 sobre el código partido y sobre árboles temporales, Linux"
