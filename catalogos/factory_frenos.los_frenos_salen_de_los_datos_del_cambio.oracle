medida factory_frenos.los_frenos_salen_de_los_datos_del_cambio:
    de frenos_caso c
    donde c.requisito == "los_frenos_salen_de_los_datos_del_cambio" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tests/test_frenos.py; asociar junto a corrida_completa"
    requiere frenos_caso
    ambito universal
    alcance "Frenos de construcción de estado: lista, avisos FRENO y JSON. Sin pruebas existentes editadas."
