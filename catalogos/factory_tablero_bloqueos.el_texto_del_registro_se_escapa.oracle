medida factory_tablero_bloqueos.el_texto_del_registro_se_escapa:
    de tablero_bloqueos_caso c
    donde c.requisito == "el_texto_del_registro_se_escapa" y c.codigo == 0
    resumen contar(1)
    umbral == 2 segun contrato porque "deben pasar los 2 casos enumerados para este requisito en tools/verify_tablero_bloqueos.py; asociar junto a corrida_completa"
    requiere tablero_bloqueos_caso
    ambito universal
    alcance "escenarios tbb3 de la página del tablero, en node con datos de un cambio, Linux"
