medida factory_lista_previa.la_lista_previa_tiene_una_sola_fuente:
    de lista_previa_caso c
    donde c.requisito == "la_lista_previa_tiene_una_sola_fuente" y c.codigo == 0
    resumen contar(1)
    umbral == 6 segun contrato porque "deben pasar los 6 casos enumerados para este requisito en tools/verify_lista_previa.py; asociar junto a corrida_completa"
    requiere lista_previa_caso
    ambito universal
    alcance "escenarios lp2 con un revisor de prueba y la CLI de verdad, Linux"
