medida factory_hora.al_unir_dos_ramas_lo_del_mismo_segundo_queda_en_el_orden_en_que_se_escribio:
    de hora_caso c
    donde c.requisito == "al_unir_dos_ramas_lo_del_mismo_segundo_queda_en_el_orden_en_que_se_escribio" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_hora.py; asociar junto a corrida_completa"
    requiere hora_caso
    ambito universal
    alcance "escenario ho2 con la union pura y el escenario a4 del banco"
