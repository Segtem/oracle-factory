medida factory_clones.escribir_a_la_vez_no_obliga_a_repetir:
    de clones_caso c
    donde c.requisito == "escribir_a_la_vez_no_obliga_a_repetir" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_clones.py; asociar junto a corrida_completa"
    requiere clones_caso
    ambito universal
    alcance "escenario cl3 con doce procesos simultaneos"
