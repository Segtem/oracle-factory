medida factory_rag_specs.contar_y_listar_specs:
    de specs_caso c
    donde c.requisito == "contar_y_listar_specs" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_rag_specs.py; asociar junto a corrida_completa"
    requiere specs_caso
    ambito universal
    alcance "escenarios rs1 a rs3 en repositorios temporales, Linux, con Oracle 0.38.2 real"
