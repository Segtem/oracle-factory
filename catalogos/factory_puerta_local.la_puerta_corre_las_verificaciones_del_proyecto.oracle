medida factory_puerta_local.la_puerta_corre_las_verificaciones_del_proyecto:
    de puerta_local_caso c
    donde c.requisito == "la_puerta_corre_las_verificaciones_del_proyecto" y c.codigo == 0
    resumen contar(1)
    umbral == 10 segun contrato porque "deben pasar los 10 casos enumerados para este requisito en tools/verify_puerta_local.py; asociar junto a corrida_completa"
    requiere puerta_local_caso
    ambito universal
    alcance "escenarios pu2 con Git de verdad, un remoto local temporal y secretos armados al vuelo, Linux"
