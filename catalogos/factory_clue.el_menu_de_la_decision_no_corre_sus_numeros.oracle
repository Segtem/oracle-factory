medida factory_clue.el_menu_de_la_decision_no_corre_sus_numeros:
    de clue_caso c
    donde c.requisito == "el_menu_de_la_decision_no_corre_sus_numeros" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "debe pasar el caso enumerado para este requisito en tools/verify_clue.py; asociar junto a corrida_completa"
    requiere clue_caso
    ambito universal
    alcance "escenarios k1-k5 en Linux con el oracle-clue del entorno de Factory"
