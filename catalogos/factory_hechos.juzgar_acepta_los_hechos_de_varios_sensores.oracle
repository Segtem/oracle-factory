medida factory_hechos.juzgar_acepta_los_hechos_de_varios_sensores:
    de hechos_caso c
    donde c.requisito == "juzgar_acepta_los_hechos_de_varios_sensores" y c.codigo == 0
    resumen contar(1)
    umbral == 4 segun contrato porque "deben pasar los 4 casos enumerados para este requisito en tools/verify_hechos_varios.py; asociar junto a corrida_completa"
    requiere hechos_caso
    ambito universal
    alcance "escenarios hv1 en repositorios temporales, Linux, con Oracle 0.39.0 real"
