medida factory_revision_binarios.el_pedido_indica_como_declarar_binarios:
    de revision_binarios_caso c
    donde c.requisito == "el_pedido_indica_como_declarar_binarios" y c.codigo == 0
    resumen contar(1)
    umbral == 1 segun contrato porque "deben pasar los 1 casos enumerados para este requisito en tests/test_revision_binarios.py; asociar junto a corrida_completa"
    requiere revision_binarios_caso
    ambito universal
    alcance "preparar la revisión: binarios omitidos del paquete"
