medida factory_procedencia.el_inventario_queda_en_el_candidato:
    de procedencia_caso c
    donde c.requisito == "el_inventario_queda_en_el_candidato" y c.codigo == 0
    resumen contar(1)
    umbral == 10 segun contrato porque "deben pasar los 10 casos enumerados para este requisito en tools/verify_procedencia.py; asociar junto a corrida_completa"
    requiere procedencia_caso
    ambito universal
    alcance "escenarios pr3 en proyectos temporales con git y un entorno simulado, Linux, sin red"
