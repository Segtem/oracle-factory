medida factory_publicada_a15.un_texto_en_preparacion_de_una_version_publicada_se_detecta:
    de publicada_a15_caso c
    donde c.requisito == "un_texto_en_preparacion_de_una_version_publicada_se_detecta" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tools/verify_publicada_a15.py; asociar junto a corrida_completa"
    requiere publicada_a15_caso
    ambito universal
    alcance "escenarios pa2 sobre los textos del repositorio y copias temporales, Linux"
