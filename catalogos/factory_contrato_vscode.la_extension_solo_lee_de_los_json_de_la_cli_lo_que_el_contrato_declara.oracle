medida factory_contrato_vscode.la_extension_solo_lee_de_los_json_de_la_cli_lo_que_el_contrato_declara:
    de contrato_vscode_caso c
    donde c.requisito == "la_extension_solo_lee_de_los_json_de_la_cli_lo_que_el_contrato_declara" y c.codigo == 0
    resumen contar(1)
    umbral == 5 segun contrato porque "deben pasar los 5 casos enumerados para este requisito en tests/test_contrato_vscode.py; asociar junto a corrida_completa"
    requiere contrato_vscode_caso
    ambito universal
    alcance "escenarios cv1–cv3 con proyectos temporales de Factory, la CLI de verdad y node, Linux"
