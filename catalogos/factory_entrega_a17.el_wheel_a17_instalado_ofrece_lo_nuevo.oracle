medida factory_entrega_a17.el_wheel_a17_instalado_ofrece_lo_nuevo:
    de entrega_a17_caso c
    donde c.requisito == "el_wheel_a17_instalado_ofrece_lo_nuevo" y c.codigo == 0
    resumen contar(1)
    umbral == 10 segun contrato porque "deben pasar los 10 casos enumerados para este requisito en tests/test_entrega_a17.py; asociar junto a corrida_completa"
    requiere entrega_a17_caso
    ambito universal
    alcance "escenarios ea1–ea3 con el repositorio, el wheel construido e instalado con uv en un entorno nuevo y datos armados para el juicio, Linux"
