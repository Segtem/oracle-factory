requisito bloqueos_c675508440ed3a2b8.el_bloqueo_de_aprobar_spec_dice_si_falta_un_archivo:
    texto "Tipo: funcional El sistema DEBE decir que falta un archivo, y no que hay que completarlo, cuando la propuesta, la spec o las tareas no existen."
