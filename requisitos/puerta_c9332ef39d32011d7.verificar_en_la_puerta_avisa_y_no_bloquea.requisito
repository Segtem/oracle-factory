requisito puerta_c9332ef39d32011d7.verificar_en_la_puerta_avisa_y_no_bloquea:
    texto "Tipo: funcional El sistema NO DEBE bloquear un push por un cambio inconsistente: DEBE avisar y dejar pasar, y la puerta DEBE seguir sin escribir nada en el proyecto."
