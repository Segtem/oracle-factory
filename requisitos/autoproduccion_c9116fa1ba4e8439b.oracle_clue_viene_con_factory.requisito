requisito autoproduccion_c9116fa1ba4e8439b.oracle_clue_viene_con_factory:
    texto "Tipo: funcional Instalar `oracle-factory` SHALL instalar `oracle-clue` en una versión fijada, y Factory SHALL usar el Clue de su propio entorno (no uno del `PATH`) para preparar paquetes y validar informes."
    fuente "openspec/changes/20261012-131420-clue-dependencia/specs/autoproduccion/spec.md#oracle-clue viene con Factory"
    sin_medir "sin medida todavía; escenarios: «instalación sola»"
