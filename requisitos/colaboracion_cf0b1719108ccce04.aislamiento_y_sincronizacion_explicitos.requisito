requisito colaboracion_cf0b1719108ccce04.aislamiento_y_sincronizacion_explicitos:
    texto "La guía SHALL describir worktrees en una máquina y clones en máquinas distintas, y distinguir aislamiento de archivos, intercambio mediante Git y acuerdo humano sobre la asignación."
