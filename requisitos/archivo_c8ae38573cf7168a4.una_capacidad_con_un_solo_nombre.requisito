requisito archivo_c8ae38573cf7168a4.una_capacidad_con_un_solo_nombre:
    texto "Tipo: funcional Un mapeo de capacidades del proyecto SHALL permitir que un cambio declarado con un nombre se fusione en la spec consolidada de otro, y `nuevo` SHALL avisar cuando la capacidad pedida es un alias del mapeo."
    fuente "openspec/changes/20261006-161029-archivar-al/specs/archivo/spec.md#una capacidad con un solo nombre"
    sin_medir "sin medida todavía; escenarios: «capacidad con alias»"
